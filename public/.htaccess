Options -MultiViews
RewriteEngine On
RewriteBase /

# Legacy double-path URL (/beam/beam) → canonical Beam Master app.
# Placed before the static rules so it fires before the /beam/ subdirectory's
# own .htaccess can turn these paths into a 404.
RewriteRule ^beam/beam(/.*)?$ /beam/ [NC,R=301,L]

# Serve static files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Handle Next.js static export routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Cache static assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>
