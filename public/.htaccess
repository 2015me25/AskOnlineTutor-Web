Options -MultiViews
RewriteEngine On
RewriteBase /

# Legacy double-path app URLs (e.g. /beam/beam, /mohr/mohr) → canonical
# single-level app URL (/beam, /mohr, ...). Covers current and future apps.
# Fires before the app subdirectories' own .htaccess rules.
RewriteRule ^([a-z0-9-]+)/\1(/.*)?$ /$1/ [NC,R=301,L]

# Serve static files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Handle Next.js static export routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Cache static assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>
